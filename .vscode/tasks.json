{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clang: Build WASM",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd /Users/oggua/Documents/GitHub/TknWeb && rm -rf build && cmake -B build -S web && cmake --build build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clang: Clean Build WASM",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd /Users/oggua/Documents/GitHub/TknWeb && rm -rf build && cmake -B build -S web && cmake --build build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clang: Build Tickernel Dylib",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd /Users/oggua/Documents/GitHub/TknWeb && rm -rf build && cmake -B build -S . && cmake --build build --target Tickernel"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clang: Clean Build Tickernel Dylib",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd /Users/oggua/Documents/GitHub/TknWeb && rm -rf build && cmake -B build -S . && cmake --build build --target Tickernel"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clang: Watch",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd /Users/oggua/Documents/GitHub/TknWeb && cmake --build build --watch"
            ],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^([^\\s].*?):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[.*\\].*Building",
                    "endsPattern": "^\\[100%\\].*|Error|error:"
                }
            }
        }
    ]
}
